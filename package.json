{
  "name": "right-to-be-forgotten",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized privacy-preserving consent management using ZKP and Cryptographic Erasure",
  "workspaces": [
    "apps/*",
    "contracts",
    "circuits"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules apps/*/node_modules contracts/node_modules circuits/node_modules"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.2.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0"
  }
}
