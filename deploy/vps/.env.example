# ==========================================================
# RightToBeForgotten — VPS deployment configuration
# Copy to .env and edit the values, then: docker compose up -d --build
# ==========================================================

# --- Subdomains (harus sudah menunjuk ke IP VPS via DNS A record) ---
VAULT_DOMAIN=vault.example.com
SP_DOMAIN=sp.example.com

# --- Let's Encrypt certificate notifications ---
LETSENCRYPT_EMAIL=admin@example.com

# --- Polygon Amoy (build-time; di-inline ke bundle frontend) ---
# Official RPC sudah dipensiunkan oleh Polygon Labs (Juli 2026).
# Fallback yang terverifikasi: https://polygon-amoy-bor-rpc.publicnode.com
NEXT_PUBLIC_POLYGON_AMOY_RPC=https://polygon-amoy.drpc.org
NEXT_PUBLIC_CONSENT_REGISTRY_ADDRESS=0xa78Ad9B4bD61950ba670AAfFb8d1235c93c3BaBA
# 'demo' cukup untuk pengembangan; ganti dengan project ID WalletConnect Anda bila perlu
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=demo
