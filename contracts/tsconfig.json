{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "outDir": "./dist",
    "declaration": true,
    "skipLibCheck": true
  },
  "include": [
    "./hardhat.config.ts",
    "./test/**/*.ts",
    "./deploy/**/*.ts",
    "./scripts/**/*.ts",
    "./typechain-types"
  ],
  "files": ["./hardhat.config.ts"]
}
